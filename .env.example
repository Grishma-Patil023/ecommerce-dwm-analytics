# =============================================================================
# E-Commerce Data Warehouse Configuration
# =============================================================================

# Default: Local SQLite (Works immediately offline with zero setup)
DB_TYPE=sqlite
SQLITE_DB_PATH=ecommerce_warehouse.db

# Optional: PostgreSQL / Cloud Supabase Connection URI
# DB_TYPE=postgres
# SUPABASE_DB_URL=postgresql://postgres:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Batch Size for ETL Ingestion
BATCH_SIZE=5000
